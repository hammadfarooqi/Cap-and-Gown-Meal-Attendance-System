# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The template is meant to be committed; real env files are not.
!.env.local.example
test-results/
playwright-report/

# Student rosters. Real names and email addresses — never in the repo.
*.csv
!supabase/**/*.csv

# Photographs of real students. Same reason as *.csv above: git history is
# permanent, and a face is more identifying than a name. The club sends these
# as an email attachment dump, so they land in whatever folder someone made.
# Tracked app icons live in public/ and are re-allowed below.
*.jpg
*.jpeg
*.heic
photos/
headshots/
fwdpicturesofmembers/
*picturesofmembers*/
photos-matched/
photos-needs-review/
!public/**
